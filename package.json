{
  "name": "fpl-arena-skarb-kibica",
  "version": "1.0.0",
  "private": true,
  "description": "Platforma FPL — FPL Arena (archiwum) + Na Minusie ™ (liga H2H)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-public.mjs",
    "prebuild": "node scripts/sync-public.mjs",
    "dev": "node scripts/dev-next.mjs",
    "dev:strict": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "dev:arena": "node scripts/sync-public.mjs && vite",
    "build:arena": "node scripts/sync-public.mjs && vite build && node scripts/verify-dist.mjs",
    "build:arena:prod": "node scripts/verify-public.mjs --strict && npm run build:arena",
    "verify-public": "node scripts/verify-public.mjs",
    "verify-dist": "node scripts/verify-dist.mjs",
    "preview:arena": "vite preview",
    "start:arena": "node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write \"{app,components,lib,src}/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/guard-e2e.mjs && playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.27.0",
    "next": "^14.2.35",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vitest": "^5.1.0"
  }
}
