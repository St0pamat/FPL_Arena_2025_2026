# Port serwera Node (npm run start) — domyślnie 3000
PORT=3000

# Supabase (Na Minusie ™ — panel admina)
# URL projektu z: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
# Klucz publiczny (anon / publishable) — NIE używaj service_role w NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-klucz-anon-lub-publishable
